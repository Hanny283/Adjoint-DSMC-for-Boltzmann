\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces How many seeds are needed just to see the gradient. The second column is the scatter of one seed's gradient divided by the size of the mean gradient. The third column is the number of seeds that makes the gradient at least twice its standard error.\relax }}{4}{table.caption.6}\protected@file@percent }
\newlabel{tab:seedsneed}{{4}{4}{How many seeds are needed just to see the gradient. The second column is the scatter of one seed's gradient divided by the size of the mean gradient. The third column is the number of seeds that makes the gradient at least twice its standard error.\relax }{table.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces This figure shows the drag reduction against iteration for the four pass-3 replicates on their own seeds. The markers show where each run doubled its seeds instead of stopping.\relax }}{4}{figure.caption.7}\protected@file@percent }
\newlabel{fig:growth}{{3}{4}{This figure shows the drag reduction against iteration for the four pass-3 replicates on their own seeds. The markers show where each run doubled its seeds instead of stopping.\relax }{figure.caption.7}{}}
